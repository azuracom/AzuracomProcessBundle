{% extends "@SonataAdmin/CRUD/list.html.twig" %}

{% block javascripts %}
    {{ parent() }}
    <script>
        $(document).ready(function(){

            var id = {{ app.request.query.get('id') ? app.request.query.get('id') : 'null' }};

            if(id && $('.load-log[data-id='+id+']').length === 1 ){
                loadLog($('.load-log[data-id='+id+']'));
            }

            $('.load-log').click(function(e){
                e.preventDefault();
                loadLog($(this));
            });
        });

        function loadLog(element){
            url = element.attr('href');
            var target = element.attr('data-target');
            $(target).modal('show');
            $(target).find('.modal-body').html("<p class='text-center'><i class='fa fa-circle-o-notch fa-spin fa-3x fa-fw'></i></p>");
            $.ajax({
                url: url,
                success: function(response){
                    $(target).find('.modal-body').html(response);       
                    if(typeof initDatatable !== 'undefined'){
                        initDatatable(target);
                    }                                         
                },
                error: function(response){
                    $(target).find('.modal-body').html("<p>{{ "azuracom_process.errors.logs_not_found"|trans }}</p>");
                }
            });
        }
    </script>
    
{% endblock %}
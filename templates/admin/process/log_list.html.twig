<table class="table log-table">
    <thead>
        <tr>
            <th>{{ "azuracom_process.log.label.date"|trans }}</th>
            <th>{{ "azuracom_process.log.label.status"|trans }}</th>
            <th>{{ "azuracom_process.log.label.message"|trans }}</th>
        </tr>
    </thead>
    <tbody>
        {% for row in rows %}
            <tr>
                <td>{{ row.datetime.date is defined ? row.datetime.date|date('d/m/Y H:i:s')  : row.datetime|date('d/m/Y H:i:s') }}</td>
                <td>
                    <span class="label label-{{ object.getStatusColorStatic(row.level_name) }}">
                        {{ row.level_name }}
                    </span>
                </td>
                <td>{{ row.message }}</td>
            </tr>
        {% endfor %}
    </tbody>
</table>
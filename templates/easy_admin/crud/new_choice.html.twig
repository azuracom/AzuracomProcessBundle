{% extends "@EasyAdmin/page/content.html.twig" %}

{% block main %}

    {% if title is defined %}
        <h1>{{ title }}</h1>
    {% endif %}
    
    <div class="row">    
        {% for choice in choices %}
            <div class="col-md-4">
                <a href="?{{ choiceKey }}={{ choice.value }}" class="card mb-3 text-center">
                    <div class="card-body">
                        {{ choice.label }}
                    </div>
                </a>
            </div>
        {% endfor %}
    </div>
{% endblock %}
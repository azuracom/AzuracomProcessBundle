<table class="table datatables">
    <thead>
        <tr>
            <th>Date</th>
            <th>Status</th>
            <th>Message</th>
        </tr>
    </thead>
    <tbody>
        {% for row in rows %}
            <tr>
                <td>{{ row.datetime.date|date('d/m/Y H:i:s') }}</td>
                <td>{{ row.level_name }}</td>
                <td>{{ row.message }}</td>
            </tr>
        {% endfor %}
    </tbody>
</table>
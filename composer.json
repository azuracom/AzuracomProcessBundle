{
    "name": "azuracom/process-bundle",
    "type": "symfony-bundle",
    "description": "Symfony process",
    "keywords": [
        "process",
        "symfony"
    ],
    "authors": [
        {
            "name": "Thibaut DUMALIN",
            "email": "tdumalin@azuracom.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "doctrine/doctrine-bundle": "^2.11 || ^3.0",
        "doctrine/orm": "^2.14 || ^3.0",
        "stof/doctrine-extensions-bundle": ">=1.5",
        "vich/uploader-bundle": ">=1.16",
        "symfony/monolog-bundle": ">=3.6"
    },
    "require-dev": {
        "doctrine/dbal": "^3.0 || ^4.0",
        "phpunit/phpunit": "^11.5 || ^12.0",
        "symfony/form": "^6.4 || ^7.0 || ^8.0",
        "symfony/framework-bundle": "^6.4 || ^7.0 || ^8.0",
        "symfony/security-core": "^6.4 || ^7.0 || ^8.0",
        "symfony/yaml": "^6.4 || ^7.0 || ^8.0"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "autoload": {
        "psr-4": {
            "Azuracom\\ProcessBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Azuracom\\ProcessBundle\\Tests\\": "tests/"
        }
    }
}
